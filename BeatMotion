<!DOCTYPE html>
<html lang="ro" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beat Motion | Dance Studio</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Permanent+Marker&display=swap" rel="stylesheet">
    <style>
        :root {
            --color-purple-light: #d8a7d8;
            --color-purple-deep: #5e17eb;
            --color-black: #1a1a1a;
            --color-white: #ffffff;
            --color-green: #2e7d32;
            --color-red: #d32f2f;
            --color-blue: #1565c0;
            --space-xs: 5px;
            --space-sm: 10px;
            --space-md: 20px;
            --space-lg: 40px;
            --space-xl: 80px;
            --radius-sm: 10px;
            --radius-md: 15px;
            --radius-lg: 30px;
            --radius-pill: 50px;
            --border-base: 2px solid var(--color-black);
            --border-thick: 3px solid var(--color-black);
            --shadow-card: 8px 8px 0px var(--color-black);
            --shadow-hover: 14px 14px 0px var(--color-purple-deep);
            --shadow-btn: 6px 6px 0 var(--color-purple-deep);
            --transition-base: 0.3s;
            --transition-slow: 0.4s;
            --lila-bg: var(--color-purple-light);
            --black: var(--color-black);
            --white: var(--color-white);
            --accent: var(--color-purple-deep);
            --form-bg: rgba(255,255,255,0.25);
            --input-focus-color: var(--color-blue);
            --input-valid-color: var(--color-green);
            --input-invalid-color: var(--color-red);
            --btn-disabled-bg: #aaa;
            --btn-disabled-cursor: not-allowed;
            --hero-text-shadow: 3px 3px 0 rgba(255,255,255,0.8), -1px -1px 0 rgba(255,255,255,0.6), 1px -1px 0 rgba(255,255,255,0.6), -1px 1px 0 rgba(255,255,255,0.6), 5px 5px 0px rgba(255,255,255,0.9), 8px 8px 0px rgba(94,23,235,0.3);
        }

        [data-theme="dark"] {
            --lila-bg: #0f0a1e;
            --black: #e8e0ff;
            --white: #1a1030;
            --accent: #a855f7;
            --form-bg: rgba(30,20,60,0.6);
            --border-base: 2px solid #a855f7;
            --border-thick: 3px solid #a855f7;
            --shadow-card: 8px 8px 0px #a855f7;
            --shadow-hover: 14px 14px 0px #7c3aed;
            --shadow-btn: 6px 6px 0 #7c3aed;
            --btn-disabled-bg: #444;
            --input-focus-color: #a855f7;
            --input-valid-color: #4ade80;
            --input-invalid-color: #f87171;
            --hero-text-shadow: 3px 3px 0 rgba(0,0,0,0.8), -1px -1px 0 rgba(0,0,0,0.6), 1px -1px 0 rgba(0,0,0,0.6), -1px 1px 0 rgba(0,0,0,0.6), 5px 5px 0px rgba(0,0,0,0.9), 8px 8px 0px rgba(168,85,247,0.5);
        }

        [data-theme="dark"] body { background-color: #0f0a1e; color: #e8e0ff; }
        [data-theme="dark"] .header { background: rgba(15,10,30,0.85); border-bottom: 2px solid #a855f7; }
        [data-theme="dark"] .header__logo-bar { background: #a855f7; }
        [data-theme="dark"] .nav__link { color: #e8e0ff; }
        [data-theme="dark"] .nav__link--cta { background: #a855f7; color: #0f0a1e !important; }
        [data-theme="dark"] .nav__link--cta:hover { background: #7c3aed; }
        [data-theme="dark"] .stats-row { background: rgba(30,20,60,0.5); border-color: #a855f7; }
        [data-theme="dark"] .card { background: rgba(30,20,60,0.7); border-color: #a855f7; color: #e8e0ff; box-shadow: 8px 8px 0px #a855f7; }
        [data-theme="dark"] .card:hover { background: #1a1030; }
        [data-theme="dark"] .orar-wrapper { border-color: #a855f7; box-shadow: 10px 10px 0 #a855f7; }
        [data-theme="dark"] .orar-table { background: rgba(20,12,40,0.9); }
        [data-theme="dark"] .orar-table__header-main th { background: #1a0a3e; border-color: #a855f7; color: #e8e0ff; }
        [data-theme="dark"] .orar-table__header-cat th { background: #6d28d9; border-color: #a855f7; }
        [data-theme="dark"] .orar-table__cell { border-color: rgba(168,85,247,0.3); color: #e8e0ff; }
        [data-theme="dark"] .orar-table__cell--label { background: #6d28d9; border-color: #a855f7; }
        [data-theme="dark"] .orar-table__row:hover { background: rgba(168,85,247,0.1); }
        [data-theme="dark"] .orar-table__cell--price { color: #c084fc; }
        [data-theme="dark"] .orar-table__cell--avail { background: rgba(74,222,128,0.1); color: #4ade80; }
        [data-theme="dark"] .orar-table__cell--unavail { background: rgba(248,113,113,0.08); color: #f87171; }
        [data-theme="dark"] .registration { background: rgba(20,12,45,0.7); border-color: #a855f7; box-shadow: 20px 20px 60px rgba(168,85,247,0.15); }
        [data-theme="dark"] .form__fieldset { background: rgba(30,15,60,0.5); border-color: #a855f7; }
        [data-theme="dark"] .form__legend { color: #c084fc; }
        [data-theme="dark"] .form__input, [data-theme="dark"] .form__select, [data-theme="dark"] .form__textarea { background: #1a0a3e; border-color: #a855f7; color: #e8e0ff; }
        [data-theme="dark"] .form__input::placeholder, [data-theme="dark"] .form__textarea::placeholder { color: #7c6fa0; }
        [data-theme="dark"] .form__label { color: #9d8fc0; }
        [data-theme="dark"] .form__input:focus + .form__label,
        [data-theme="dark"] .form__input:not(:placeholder-shown) + .form__label,
        [data-theme="dark"] .form__textarea:focus + .form__label,
        [data-theme="dark"] .form__textarea:not(:placeholder-shown) + .form__label { background: #1a0a3e; color: #c084fc; border-color: #a855f7; }
        [data-theme="dark"] .form__select option { background: #1a0a3e; color: #e8e0ff; }
        [data-theme="dark"] .form__submit { background: #444; }
        [data-theme="dark"] .form__submit--active { background: #a855f7; }
        [data-theme="dark"] .form__submit--active:hover { background: #7c3aed; }
        [data-theme="dark"] .contact-card { background: #1a0a3e; border: 2px solid #a855f7; }
        [data-theme="dark"] .schedule-card { background: #6d28d9; border-color: #a855f7; }
        [data-theme="dark"] .section-title { color: #e8e0ff; }
        [data-theme="dark"] .hero__subtitle { color: rgba(232,224,255,0.7); }
        [data-theme="dark"] .hero__cta--secondary { border-color: #a855f7; color: #e8e0ff; }
        [data-theme="dark"] .hero__cta--secondary:hover { background: #a855f7; color: #0f0a1e; }
        [data-theme="dark"] .success-box { background: #1a0a3e; border-color: #a855f7; box-shadow: 20px 20px 0 #7c3aed; }
        [data-theme="dark"] #successOverlay { background: rgba(10,5,30,0.9); }
        [data-theme="dark"] .footer { background: #07040f; border-top: 2px solid #a855f7; }
        [data-theme="dark"] .hero__scroll-hint span { background: #a855f7; }
        [data-theme="dark"] .hero__scroll-hint { color: #a855f7; }
        [data-theme="dark"] .orar-table__cell--label { color: #fff; }
        [data-theme="dark"] .media-section { background: rgba(20,12,45,0.7); border-color: #a855f7; box-shadow: 20px 20px 60px rgba(168,85,247,0.15); }
        [data-theme="dark"] .media-block { border-color: #a855f7; box-shadow: 8px 8px 0px #a855f7; background: rgba(30,15,60,0.5); }
        [data-theme="dark"] .media-block__title { color: #c084fc; }
        [data-theme="dark"] .dance-modal__inner { background: #0f0a1e; border-color: #a855f7; box-shadow: 20px 20px 0 #7c3aed; }
        [data-theme="dark"] .dance-modal__header { background: #1a0a3e; border-color: #a855f7; }
        [data-theme="dark"] .dance-modal__subtitle { color: #c084fc; }
        [data-theme="dark"] .dance-modal__close { background: #a855f7; color: #0f0a1e; border-color: #7c3aed; }
        [data-theme="dark"] .dance-modal__close:hover { background: #7c3aed; }
        [data-theme="dark"] .dance-modal__style-block { background: rgba(30,15,60,0.6); border-color: #a855f7; }
        [data-theme="dark"] .dance-modal__style-block h4 { color: #c084fc; }
        [data-theme="dark"] .dance-modal__style-block p { color: #b8a8e0; }
        [data-theme="dark"] .dance-modal__teacher-card { background: rgba(30,15,60,0.8); border-color: #a855f7; }
        [data-theme="dark"] .dance-modal__teacher-name { color: #e8e0ff; }
        [data-theme="dark"] .dance-modal__teacher-role { color: #c084fc; }
        [data-theme="dark"] .dance-modal__teacher-exp { color: #9d8fc0; }
        [data-theme="dark"] .dance-modal__section-title { color: #e8e0ff; }
        [data-theme="dark"] .dance-modal__section-title::after { background: #a855f7; }
        [data-theme="dark"] .dance-modal__enroll-btn { background: #a855f7; box-shadow: 6px 6px 0 #7c3aed; }
        [data-theme="dark"] .dance-modal__enroll-btn:hover { background: #7c3aed; }
        [data-theme="dark"] .dance-modal__img-placeholder { background: rgba(168,85,247,0.15); border-color: #a855f7; color: #a855f7; }

        /* ── HAMBURGER MENU ── */
        .nav__hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 8px;
            background: none;
            border: none;
            z-index: 1002;
        }
        .nav__hamburger span {
            display: block;
            width: 26px;
            height: 3px;
            background: var(--black);
            border-radius: 2px;
            transition: transform 0.3s, opacity 0.3s;
        }
        .nav__hamburger.open span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
        .nav__hamburger.open span:nth-child(2) { opacity: 0; }
        .nav__hamburger.open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

        .theme-toggle {
            display: inline-flex; align-items: center; gap: 10px;
            margin-top: 30px; padding: 12px 28px;
            background: transparent; border: 3px solid var(--black);
            border-radius: var(--radius-pill);
            font-family: 'Montserrat', sans-serif; font-size: 0.9rem; font-weight: 900;
            letter-spacing: 2px; text-transform: uppercase; color: var(--black);
            cursor: pointer; transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
            position: relative; z-index: 1; will-change: transform;
        }
        .theme-toggle:hover { background: var(--black); color: var(--lila-bg); transform: translateY(-3px); box-shadow: var(--shadow-btn); }
        .theme-toggle__icon { font-size: 1.1rem; transition: transform 0.4s ease; display: inline-block; }
        .theme-toggle:hover .theme-toggle__icon { transform: rotate(20deg) scale(1.2); }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; scroll-behavior: smooth; }
        body { background-color: var(--lila-bg); color: var(--black); overflow-x: hidden; transition: background-color 0.4s, color 0.4s; }

        #starCanvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1; will-change: transform; }

        /* ── HEADER ── */
        .header {
            padding: 1.2rem 5%;
            display: flex; justify-content: space-between; align-items: center;
            background: rgba(216,167,216,0.8);
            backdrop-filter: blur(10px);
            position: sticky; top: 0; z-index: 1001;
            border-bottom: var(--border-base);
            transition: background 0.4s, border-color 0.4s;
        }
        .header__logo { display: flex; align-items: center; gap: 12px; }
        .header__logo-icon { width: 36px; height: 26px; display: flex; align-items: flex-end; gap: 3px; flex-shrink: 0; }
        .header__logo-bar { flex: 1; background: var(--black); animation: beat 0.8s infinite alternate; transition: background 0.4s; }
        .header__logo-bar:nth-child(2) { height: 100%; animation-delay: 0.2s; }
        .header__logo-bar:nth-child(1), .header__logo-bar:nth-child(3) { height: 60%; animation-delay: 0.4s; }
        @keyframes beat { from { transform: scaleY(0.5); } to { transform: scaleY(1.2); } }
        .header__logo-text { font-family: 'Permanent Marker', cursive; font-size: 1.6rem; white-space: nowrap; }
        .nav__list { display: flex; list-style: none; gap: 28px; align-items: center; }
        .nav__link { text-decoration: none; color: var(--black); font-weight: 700; transition: var(--transition-base); position: relative; white-space: nowrap; }
        .nav__link::after { content: ''; position: absolute; width: 0; height: 2px; bottom: -5px; left: 0; background: var(--accent); transition: var(--transition-base); }
        .nav__link:hover::after { width: 100%; }
        .nav__link--cta { background: var(--black); color: white !important; padding: 10px 18px; border-radius: var(--radius-pill); }
        .nav__link--cta:hover { background: var(--accent); transform: scale(1.05); }
        .nav__link--cta::after { display: none; }

        /* ── HERO ── */
        .hero {
            text-align: center;
            padding: 120px 20px 100px;
            position: relative;
            min-height: 100vh;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            overflow: hidden;
        }
        .hero::before { content: ''; position: absolute; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(94,23,235,0.15) 0%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%,-50%); animation: pulse-glow 4s ease-in-out infinite; pointer-events: none; }
        .hero::after { content: ''; position: absolute; width: 400px; height: 400px; border-radius: 50%; border: 3px dashed rgba(94,23,235,0.25); top: 50%; left: 50%; transform: translate(-50%,-50%); animation: spin-slow 20s linear infinite; will-change: transform; pointer-events: none; }
        @keyframes pulse-glow { 0%,100% { transform: translate(-50%,-50%) scale(1); opacity: 0.8; } 50% { transform: translate(-50%,-50%) scale(1.15); opacity: 1; } }
        @keyframes spin-slow { from { transform: translate(-50%,-50%) rotate(0deg); } to { transform: translate(-50%,-50%) rotate(360deg); } }

        .hero__badge { display: inline-block; background: var(--accent); color: white; font-size: 0.72rem; font-weight: 900; letter-spacing: 3px; text-transform: uppercase; padding: 8px 18px; border-radius: var(--radius-pill); margin-bottom: 22px; border: var(--border-base); box-shadow: 4px 4px 0 var(--black); animation: float-badge 3s ease-in-out infinite; will-change: transform; }
        @keyframes float-badge { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

        .hero__title {
            font-family: 'Permanent Marker', cursive;
            font-size: clamp(2.4rem, 7vw, 6rem);
            text-shadow: var(--hero-text-shadow);
            margin-bottom: 20px;
            line-height: 1.1;
            position: relative;
            z-index: 1;
        }
        [data-theme="light"] .hero__title { color: #1a1a1a; }
        [data-theme="dark"] .hero__title { color: #e8e0ff; }

        .hero__subtitle { font-size: 1.05rem; font-weight: 700; color: rgba(26,26,26,0.7); max-width: 480px; margin: 0 auto 38px; position: relative; z-index: 1; text-shadow: 1px 1px 0 rgba(255,255,255,0.9), -1px -1px 0 rgba(255,255,255,0.9), 0 1px 4px rgba(255,255,255,0.7); }
        [data-theme="dark"] .hero__subtitle { text-shadow: none; }

        .section-title { text-align: center; font-family: 'Permanent Marker', cursive; font-size: clamp(1.6rem, 4vw, 2.2rem); margin-bottom: 45px; position: relative; text-shadow: 2px 2px 0 rgba(255,255,255,0.7), -1px -1px 0 rgba(255,255,255,0.5); }
        [data-theme="dark"] .section-title { text-shadow: 2px 2px 0 rgba(0,0,0,0.7); }
        .section-title::after { content: ''; display: block; width: 70px; height: 4px; background: var(--accent); margin: 12px auto 0; border-radius: 2px; }

        .hero__cta-group { display: flex; gap: 15px; flex-wrap: wrap; justify-content: center; position: relative; z-index: 1; flex-direction: column; align-items: center; }
        .hero__cta-btns { display: flex; gap: 15px; flex-wrap: wrap; justify-content: center; }
        .hero__cta--primary { padding: 15px 36px; background: var(--black); color: white; border: none; border-radius: var(--radius-pill); font-size: 0.95rem; font-weight: 900; cursor: pointer; text-decoration: none; letter-spacing: 2px; text-transform: uppercase; transition: var(--transition-base); box-shadow: var(--shadow-btn); will-change: transform; }
        .hero__cta--primary:hover { background: var(--accent); transform: translateY(-3px); box-shadow: 8px 8px 0 var(--black); }
        .hero__cta--secondary { padding: 15px 36px; background: transparent; color: var(--black); border: 3px solid var(--black); border-radius: var(--radius-pill); font-size: 0.95rem; font-weight: 900; cursor: pointer; text-decoration: none; letter-spacing: 2px; text-transform: uppercase; transition: var(--transition-base); will-change: transform; }
        .hero__cta--secondary:hover { background: var(--black); color: white; transform: translateY(-3px); }
        .hero__scroll-hint { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 0.65rem; font-weight: 900; letter-spacing: 3px; text-transform: uppercase; opacity: 0.5; animation: bounce-hint 2s ease-in-out infinite; will-change: transform; z-index: 1; }
        .hero__scroll-hint span { width: 2px; height: 28px; background: var(--black); display: block; }
        @keyframes bounce-hint { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(8px); } }

        /* ── STATS ── */
        .stats-row { display: flex; justify-content: center; gap: 40px; padding: var(--space-lg) 5%; flex-wrap: wrap; background: rgba(255,255,255,0.2); border-top: var(--border-base); border-bottom: var(--border-base); transition: background 0.4s, border-color 0.4s; }
        .stats-row__item { text-align: center; }
        .stats-row__number { font-family: 'Permanent Marker', cursive; font-size: 2.4rem; color: var(--accent); display: block; line-height: 1; }
        .stats-row__label { font-size: 0.72rem; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; opacity: 0.6; }

        .divider { height: 36px; background: repeating-linear-gradient(90deg, var(--accent) 0 20px, transparent 20px 40px); animation: move 2s linear infinite; opacity: 0.7; }
        @keyframes move { from { background-position: 0; } to { background-position: 40px; } }

        /* ── SERVICES ── */
        .services-section { padding: var(--space-xl) 5%; }
        .services-grid { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; min-height: 60px; position: relative; }

        .card {
            padding: 22px 32px 26px;
            border: var(--border-thick);
            border-radius: var(--radius-md);
            font-family: 'Permanent Marker', cursive; font-size: 1.5rem;
            background: var(--form-bg);
            backdrop-filter: blur(5px);
            transition: var(--transition-slow);
            cursor: pointer;
            box-shadow: var(--shadow-card);
            position: relative; overflow: hidden;
            min-width: 190px;
            width: calc(33% - 24px);
            max-width: 260px;
            text-align: center;
            will-change: transform;
            color: var(--black);
            user-select: none;
        }
        .card__img-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 120px;
            height: 120px;
            margin: 0 auto 12px;
            border-radius: var(--radius-sm);
            border: 2px dashed var(--accent);
            background: rgba(94,23,235,0.06);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.6rem;
            font-weight: 900;
            letter-spacing: 2px;
            color: var(--accent);
            text-transform: uppercase;
            transition: transform var(--transition-slow);
            position: relative;
            overflow: hidden;
        }
        .card__desc { font-family: 'Montserrat', sans-serif; font-size: 0.78rem; font-weight: 700; letter-spacing: 1px; opacity: 0.7; margin-top: 8px; display: block; }
        .card__click-hint { font-family: 'Montserrat', sans-serif; font-size: 0.62rem; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); margin-top: 10px; display: block; opacity: 0; transition: opacity 0.3s; }
        .card:hover { transform: translateY(-10px) rotate(2deg); background: var(--white); box-shadow: var(--shadow-hover); }
        .card:hover .card__img-placeholder { transform: scale(1.06) rotate(-3deg); }
        .card:hover .card__click-hint { opacity: 1; }

        /* ── DANCE MODAL ── */
        .dance-modal { display: none; position: fixed; inset: 0; background: rgba(26,26,26,0.85); z-index: 9998; justify-content: center; align-items: flex-start; backdrop-filter: blur(8px); overflow-y: auto; padding: 30px 16px; }
        .dance-modal.show { display: flex; }
        .dance-modal__inner { background: var(--lila-bg); border: var(--border-thick); border-radius: var(--radius-lg); max-width: 860px; width: 100%; box-shadow: 20px 20px 0 var(--accent); animation: pop-in 0.45s cubic-bezier(0.34,1.56,0.64,1); position: relative; overflow: hidden; }
        @keyframes pop-in { from { transform: scale(0.5) rotate(-3deg); opacity: 0; } to { transform: scale(1) rotate(0); opacity: 1; } }
        .dance-modal__header { background: var(--accent); padding: 28px 30px 24px; position: relative; }
        .dance-modal__title { font-family: 'Permanent Marker', cursive; font-size: clamp(1.5rem, 4vw, 2.2rem); color: white; text-shadow: 3px 3px 0 rgba(0,0,0,0.3); margin-bottom: 6px; }
        .dance-modal__subtitle { font-size: 0.8rem; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.75); }
        .dance-modal__close { position: absolute; top: 16px; right: 16px; background: white; color: var(--accent); border: 3px solid var(--black); border-radius: 50%; width: 40px; height: 40px; font-size: 1.2rem; font-weight: 900; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: var(--transition-base); line-height: 1; }
        .dance-modal__close:hover { background: var(--black); color: white; transform: rotate(90deg) scale(1.1); }
        .dance-modal__body { padding: 28px 24px; }
        .dance-modal__section-title { font-family: 'Permanent Marker', cursive; font-size: 1.4rem; margin-bottom: 18px; display: flex; align-items: center; gap: 12px; }
